{
  "expo": {
    "name": "FocoFlow",
    "slug": "focoflow",
    "scheme": "focoflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.focoflow.app"
    },
    "android": {
      "package": "com.focoflow.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ]
  }
}
